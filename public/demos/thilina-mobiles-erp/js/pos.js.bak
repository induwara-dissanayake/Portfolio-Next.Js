// Save repair edit
function savePOSRepairEdit(repairId) {
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) {
    showNotification("Repair not found", "error");
    return;
  }

  // Update repair data
  repair.issue = document.getElementById("edit-repair-issue").value;
  repair.estimatedCost =
    parseFloat(document.getElementById("edit-repair-cost").value) || 0;
  repair.status = document.getElementById("edit-repair-status").value;
  repair.technician = document.getElementById("edit-repair-technician").value;
  repair.notes = document.getElementById("edit-repair-notes").value;

  // If status is completed, set completion date
  if (repair.status === "completed" && !repair.completedDate) {
    repair.completedDate = new Date().toISOString().split("T")[0];
  }

  closePOSRepairEditModal();
  loadPOSRepairs(); // Refresh the repairs table
  showNotification(`Repair ${repairId} updated successfully`, "success");
}

// Close repair edit modal
function closePOSRepairEditModal() {
  const modal = document.getElementById("pos-repair-edit-modal");
  if (modal) {
    modal.remove();
  }
}

// Open repair invoice from POS - Full functionality like repairs.js
function openPOSRepairInvoice(repairId) {
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) {
    showNotification("Repair not found", "error");
    return;
  }

  // Ensure mock repair products exist
  ensureMockRepairProducts();

  // Ensure repair has items array
  if (!repair.items) {
    repair.items = [];
  }

  const modalContent = `
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onclick="closePOSRepairInvoiceModal()">
            <div class="bg-white rounded-lg p-6 max-w-5xl w-full mx-4 max-h-[90vh] overflow-hidden flex flex-col" onclick="event.stopPropagation()">
                <div class="flex justify-between items-center mb-4 flex-shrink-0">
                    <h2 class="text-xl font-bold text-gray-800">Repair Invoice - ${repair.id}</h2>
                    <button onclick="closePOSRepairInvoiceModal()" class="text-gray-500 hover:text-gray-700">
                        <i data-feather="x" class="w-5 h-5"></i>
                    </button>
                </div>
                
                <div id="pos-repair-invoice-content" class="flex-1 overflow-y-auto">
                    <!-- Content will be populated by renderPOSRepairInvoice -->
                </div>
                
                <div class="flex justify-between items-center p-4 border-t bg-white flex-shrink-0">
                    <div class="text-sm text-gray-600" id="pos-repair-invoice-totals">Totals: Cost Rs.0 | Pricing Rs.0</div>
                    <div class="flex space-x-3">
                        <button type="button" onclick="handleUpdatePOSRepairInvoice('${repair.id}')" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Update & Save Changes</button>
                        <button type="button" onclick="printPOSRepairInvoice('${repair.id}')" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Print</button>
                        <button type="button" onclick="finalizeRepairInvoice('${repair.id}')" class="bg-purple-500 text-white px-4 py-2 rounded hover:bg-purple-600">Finalize & Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>
    `;

  // Add modal to page
  const modalDiv = document.createElement("div");
  modalDiv.id = "pos-repair-invoice-modal";
  modalDiv.dataset.repairId = repairId;
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  // Render the invoice content
  renderPOSRepairInvoice(repair);

  // Initialize feather icons
  feather.replace();
}

