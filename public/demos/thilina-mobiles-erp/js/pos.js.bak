// Load repairs table
function loadRepairsTable() {
  const tbody = document.getElementById("repairsTableBody");
  tbody.innerHTML = "";

  repairOrders.forEach((repair) => {
    const row = document.createElement("tr");
    row.className = "hover:bg-gray-50";

    // Status badge styling
    let statusClass = "bg-gray-100 text-gray-800";
    switch (repair.status.toLowerCase()) {
      case "completed":
        statusClass = "bg-green-100 text-green-800";
        break;
      case "in progress":
        statusClass = "bg-blue-100 text-blue-800";
        break;
      case "pending":
        statusClass = "bg-yellow-100 text-yellow-800";
        break;
      case "cancelled":
        statusClass = "bg-red-100 text-red-800";
        break;
    }

    row.innerHTML = `
            <td class="px-4 py-3 text-sm font-medium text-gray-900">${
              repair.id
            }</td>
            <td class="px-4 py-3 text-sm text-gray-700">${
              repair.customer
            }<br><span class="text-xs text-gray-500">${repair.phone}</span></td>
            <td class="px-4 py-3 text-sm text-gray-700">${repair.brand} ${
      repair.device
    }</td>
            <td class="px-4 py-3 text-sm text-gray-700">${repair.issue}</td>
            <td class="px-4 py-3">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${statusClass}">
                    ${repair.status}
                </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">₹${repair.estimatedCost.toLocaleString()}</td>
            <td class="px-4 py-3 text-sm text-gray-500">${
              repair.dateReceived
            }</td>
            <td class="px-4 py-3 text-sm">
                <div class="flex space-x-2">
                    <button onclick="editRepair('${
                      repair.id
                    }')" class="text-blue-600 hover:text-blue-800 p-1" title="Edit">
                        <i data-feather="edit-2" class="w-4 h-4"></i>
                    </button>
                    <button onclick="updateRepairStatus('${
                      repair.id
                    }')" class="text-green-600 hover:text-green-800 p-1" title="Update Status">
                        <i data-feather="check-circle" class="w-4 h-4"></i>
                    </button>
                    <button onclick="deleteRepair('${
                      repair.id
                    }')" class="text-red-600 hover:text-red-800 p-1" title="Delete">
                        <i data-feather="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </td>
        `;

    tbody.appendChild(row);
  });

  // Re-initialize feather icons
  feather.replace();
}

// Add new repair
function addRepair() {
  const customerName = document
    .getElementById("repairCustomerName")
    .value.trim();
  const customerPhone = document
    .getElementById("repairCustomerPhone")
    .value.trim();
  const deviceModel = document.getElementById("repairDeviceModel").value.trim();
  const deviceBrand = document.getElementById("repairDeviceBrand").value;
  const issue = document.getElementById("repairIssue").value.trim();
  const estimatedCost =
    parseFloat(document.getElementById("repairEstimatedCost").value) || 0;
  const priority = document.getElementById("repairPriority").value;

  // Validation
  if (
    !customerName ||
    !customerPhone ||
    !deviceModel ||
    !deviceBrand ||
    !issue
  ) {
    showNotification("Please fill in all required fields", "error");
    return;
  }

  // Generate new repair ID
  const newId = `RP-2024-${String(repairOrders.length + 1).padStart(3, "0")}`;

  // Create new repair object
  const newRepair = {
    id: newId,
    customer: customerName,
    phone: customerPhone,
    device: deviceModel,
    brand: deviceBrand,
    issue: issue,
    status: "Pending",
    estimatedCost: estimatedCost,
    priority: priority,
    dateReceived: new Date().toISOString().split("T")[0],
    technician: "Unassigned",
  };

  // Add to repairs array
  repairOrders.push(newRepair);

  // Refresh table
  loadRepairsTable();

  // Close modal and show success
  closeAddRepairModal();
  showNotification(`Repair order ${newId} created successfully`, "success");
}

// Search repairs
function searchRepairs() {
  const searchTerm = document
    .getElementById("repairSearchInput")
    .value.toLowerCase();
  filterRepairs(searchTerm);
}

// Filter repairs by status
function filterRepairsByStatus() {
  const statusFilter = document.getElementById("statusFilter").value;
  const searchTerm = document
    .getElementById("repairSearchInput")
    .value.toLowerCase();
  filterRepairs(searchTerm, statusFilter);
}

// Filter repairs function
function filterRepairs(searchTerm = "", statusFilter = "") {
  const tbody = document.getElementById("repairsTableBody");
  const rows = tbody.querySelectorAll("tr");

  rows.forEach((row) => {
    const text = row.textContent.toLowerCase();
    const statusText = row.querySelector(".rounded-full").textContent.trim();

    const matchesSearch = !searchTerm || text.includes(searchTerm);
    const matchesStatus =
      !statusFilter ||
      statusText.toLowerCase().includes(statusFilter.toLowerCase());

    if (matchesSearch && matchesStatus) {
      row.style.display = "";
    } else {
      row.style.display = "none";
    }
  });
}

// Edit repair (placeholder function)
function editRepair(repairId) {
  showNotification(
    `Edit functionality for ${repairId} will be implemented`,
    "info"
  );
}

// Update repair status (placeholder function)
function updateRepairStatus(repairId) {
  const repair = repairOrders.find((r) => r.id === repairId);
  if (repair) {
    // Cycle through statuses
    const statuses = ["Pending", "In Progress", "Completed", "Cancelled"];
    const currentIndex = statuses.indexOf(repair.status);
    const nextIndex = (currentIndex + 1) % statuses.length;
    repair.status = statuses[nextIndex];

    loadRepairsTable();
    showNotification(
      `Repair ${repairId} status updated to ${repair.status}`,
      "success"
    );
  }
}

// Delete repair
function deleteRepair(repairId) {
  if (confirm(`Are you sure you want to delete repair ${repairId}?`)) {
    repairOrders = repairOrders.filter((r) => r.id !== repairId);
    loadRepairsTable();
    showNotification(`Repair ${repairId} deleted successfully`, "success");
  }
}

// ==================== POS REPAIR FUNCTIONS ====================

// Handle repair search input
function handleRepairSearch() {
  filterPOSRepairs();
}

// Filter repairs in POS (using status filter)
function filterPOSRepairs() {
  const searchInput = document.getElementById("repair-search-input");
  const statusFilterEl = document.getElementById("repair-status-filter");

  const searchTerm = searchInput ? searchInput.value.toLowerCase() : "";
  const statusFilter = statusFilterEl ? statusFilterEl.value : "";

  if (!window.currentRepairsData) return;

  const filteredRepairs = window.currentRepairsData.filter((repair) => {
    const matchesSearch =
      !searchTerm ||
      repair.id.toLowerCase().includes(searchTerm) ||
      repair.device.toLowerCase().includes(searchTerm) ||
      repair.customer.toLowerCase().includes(searchTerm) ||
      repair.issue.toLowerCase().includes(searchTerm);

    const matchesStatus = !statusFilter || repair.status === statusFilter;

    return matchesSearch && matchesStatus;
  });

  loadPOSRepairs(filteredRepairs);
}

