// Render repair invoice content
function renderPOSRepairInvoice(repair) {
  if (!repair.items) repair.items = [];

  const rows = repair.items
    .map((item, idx) => buildPOSInvoiceRow(idx + 1, item))
    .join("");

  const html = `
    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-gray-50 p-4 rounded">
          <h3 class="font-semibold text-gray-800 mb-2">Customer</h3>
          <p class="text-sm"><strong>Name:</strong> ${
            repair.customer || "-"
          }</p>
          <p class="text-sm"><strong>Phone:</strong> ${repair.phone || "-"}</p>
          <p class="text-sm"><strong>Email:</strong> ${repair.email || "-"}</p>
        </div>
        <div class="bg-gray-50 p-4 rounded">
          <h3 class="font-semibold text-gray-800 mb-2">Device</h3>
          <p class="text-sm"><strong>Model:</strong> ${repair.device || "-"}</p>
          <p class="text-sm"><strong>IMEI:</strong> ${repair.imei || "-"}</p>
          <p class="text-sm"><strong>Issue:</strong> ${repair.issue || "-"}</p>
        </div>
      </div>
      <div>
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-lg font-medium text-gray-900">Items / Materials</h3>
          <button type="button" onclick="addPOSRepairInvoiceRow()" class="px-3 py-1.5 text-sm rounded bg-blue-600 text-white">Add Item</button>
        </div>
        <div class="overflow-x-auto border border-gray-200 rounded-lg">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-100">
              <tr>
                <th class="px-3 py-2 text-left">#</th>
                <th class="px-3 py-2 text-left">Item</th>
                <th class="px-3 py-2 text-left">Cost (Rs.)</th>
                <th class="px-3 py-2 text-left">Pricing (Rs.)</th>
                <th class="px-3 py-2"></th>
              </tr>
            </thead>
            <tbody id="pos-repair-invoice-items-body">${
              rows ||
              '<tr><td colspan="5" class="px-3 py-4 text-center text-gray-500">No items added</td></tr>'
            }</tbody>
            <tfoot class="bg-gray-50">
              <tr>
                <td colspan="2" class="px-3 py-2 font-medium">Totals</td>
                <td class="px-3 py-2" id="pos-invoice-total-cost">0</td>
                <td class="px-3 py-2">
                  <div class="flex items-center space-x-2">
                    <span class="text-gray-500 text-sm">Rs.</span>
                    <input type="number" id="pos-invoice-total-price-editable" step="0.01" min="0" 
                      class="w-24 px-2 py-1 border border-gray-300 rounded text-right font-semibold text-blue-600" />
                    <span id="pos-invoice-total-price" class="hidden">0</span>
                  </div>
                </td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>`;

  document.getElementById("pos-repair-invoice-content").innerHTML = html;
  recalcPOSInvoiceTotals();
  feather.replace();
}

// Build invoice row
function buildPOSInvoiceRow(lineNo, item) {
  return `<tr data-line="${lineNo}">
    <td class="px-3 py-2">${lineNo}</td>
    <td class="px-3 py-2">
      <div class="relative">
        <input type="text" class="pos-invoice-item-input w-full border border-gray-300 rounded px-2 py-1 text-sm" 
               value="${item.name || ""}" placeholder="Search or type item..." 
               oninput="handlePOSInvoiceItemInput(this)" />
        <div class="pos-invoice-item-results absolute left-0 right-0 mt-1 bg-white border border-gray-200 rounded shadow-lg max-h-40 overflow-y-auto hidden z-10"></div>
      </div>
    </td>
    <td class="px-3 py-2">
      <input type="number" class="pos-invoice-cost-input w-24 border border-gray-300 rounded px-2 py-1 text-sm" 
             value="${
               item.cost || 0
             }" min="0" oninput="recalcPOSInvoiceTotals()" />
    </td>
    <td class="px-3 py-2">
      <input type="number" class="pos-invoice-price-input w-24 rounded px-2 py-1 text-sm" 
             style="border:2px solid #16a34a" value="${
               item.price || 0
             }" min="0" oninput="recalcPOSInvoiceTotals()" />
    </td>
    <td class="px-3 py-2 text-right">
      <button type="button" onclick="removePOSInvoiceRow(${lineNo})" class="text-red-600 hover:text-red-800">
        <i data-feather="trash" class="w-4 h-4"></i>
      </button>
    </td>
  </tr>`;
}

// Add repair invoice row
function addPOSRepairInvoiceRow() {
  const tbody = document.getElementById("pos-repair-invoice-items-body");
  if (!tbody) return;

  if (
    tbody.children.length === 1 &&
    tbody.children[0].querySelector("td[colspan]")
  ) {
    tbody.innerHTML = "";
  }

  const lineNo = tbody.children.length + 1;
  const tempItem = {
    name: "",
    cost: 0,
    price: 0,
    productId: null,
    isProduct: false,
  };
  tbody.insertAdjacentHTML("beforeend", buildPOSInvoiceRow(lineNo, tempItem));
  feather.replace();
  recalcPOSInvoiceTotals();
}

// Remove invoice row
function removePOSInvoiceRow(lineNo) {
  const tbody = document.getElementById("pos-repair-invoice-items-body");
  if (!tbody) return;

  const row = Array.from(tbody.children).find((r) => r.dataset.line == lineNo);
  if (row) row.remove();

  // Renumber rows
  Array.from(tbody.children).forEach((r, idx) => {
    r.dataset.line = idx + 1;
    r.querySelector("td:first-child").textContent = idx + 1;
  });

  recalcPOSInvoiceTotals();
}

// Handle invoice item input
function handlePOSInvoiceItemInput(inputEl) {
  const query = inputEl.value.trim().toLowerCase();
  const resultsEl = inputEl.parentElement.querySelector(
    ".pos-invoice-item-results"
  );

  if (!query) {
    resultsEl.classList.add("hidden");
    return;
  }

  const matches = (window.productsData || [])
    .filter((p) => p.name && p.name.toLowerCase().includes(query))
    .slice(0, 10);

  if (matches.length === 0) {
    resultsEl.innerHTML =
      '<div class="px-2 py-1 text-sm text-gray-500">No matches</div>';
    resultsEl.classList.remove("hidden");
    return;
  }

  resultsEl.innerHTML = matches
    .map(
      (p) =>
        `<div class="px-2 py-1 hover:bg-blue-50 cursor-pointer text-sm" 
              onclick="selectPOSInvoiceProduct(this, '${p.id}', '${(
          p.name || ""
        ).replace(/'/g, "&#39;")}', ${p.cost || 0}, ${p.price || 0})">
           ${p.name}
         </div>`
    )
    .join("");
  resultsEl.classList.remove("hidden");
}

// Select invoice product
function selectPOSInvoiceProduct(el, productId, name, cost, price) {
  const resultsEl = el.parentElement;
  const wrapper = resultsEl.parentElement;
  const inputEl = wrapper.querySelector(".pos-invoice-item-input");

  inputEl.value = name;
  resultsEl.classList.add("hidden");

  const row = wrapper.closest("tr");
  row.dataset.productId = productId;
  row.dataset.isProduct = "true";

  const costInput = row.querySelector(".pos-invoice-cost-input");
  const priceInput = row.querySelector(".pos-invoice-price-input");

  costInput.value = cost;
  priceInput.value = price;
  recalcPOSInvoiceTotals();
}

// Recalculate invoice totals
function recalcPOSInvoiceTotals() {
  const tbody = document.getElementById("pos-repair-invoice-items-body");
  let totalCost = 0,
    totalPrice = 0;

  if (tbody) {
    Array.from(tbody.children).forEach((row) => {
      if (!row.querySelector("td[colspan]")) {
        const costInput = row.querySelector(".pos-invoice-cost-input");
        const priceInput = row.querySelector(".pos-invoice-price-input");
        if (costInput && priceInput) {
          totalCost += parseFloat(costInput.value) || 0;
          totalPrice += parseFloat(priceInput.value) || 0;
        }
      }
    });
  }

  const costEl = document.getElementById("pos-invoice-total-cost");
  const priceEl = document.getElementById("pos-invoice-total-price");
  const priceEditableEl = document.getElementById(
    "pos-invoice-total-price-editable"
  );

  if (costEl) costEl.textContent = totalCost.toLocaleString();
  if (priceEl) priceEl.textContent = totalPrice.toLocaleString();
  if (priceEditableEl) priceEditableEl.value = totalPrice.toFixed(2);

  const summary = document.getElementById("pos-repair-invoice-totals");
  if (summary)
    summary.textContent = `Totals: Cost Rs.${totalCost.toLocaleString()} | Pricing Rs.${totalPrice.toLocaleString()}`;
}

// Update repair invoice
function handleUpdatePOSRepairInvoice(repairId) {
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) return;

  const tbody = document.getElementById("pos-repair-invoice-items-body");
  const items = [];

  if (tbody) {
    Array.from(tbody.children).forEach((row, index) => {
      if (!row.querySelector("td[colspan]")) {
        const nameInput = row.querySelector(".pos-invoice-item-input");
        const costInput = row.querySelector(".pos-invoice-cost-input");
        const priceInput = row.querySelector(".pos-invoice-price-input");

        if (nameInput && costInput && priceInput && nameInput.value.trim()) {
          items.push({
            lineNo: index + 1,
            name: nameInput.value.trim(),
            cost: parseFloat(costInput.value) || 0,
            price: parseFloat(priceInput.value) || 0,
            productId: row.dataset.productId || null,
            isProduct: row.dataset.isProduct === "true",
          });
        }
      }
    });
  }

  repair.items = items;

  // Update estimated cost based on editable total price if available
  const priceEditableEl = document.getElementById(
    "pos-invoice-total-price-editable"
  );
  const totalPrice = priceEditableEl
    ? parseFloat(priceEditableEl.value) || 0
    : items.reduce((sum, item) => sum + item.price, 0);
  if (totalPrice > 0) {
    repair.estimatedCost = totalPrice;
  }

  // Add repair to cart with updated total
  addRepairToCart(repairId);

  // Close modal
  closePOSRepairInvoiceModal();

  recalcPOSInvoiceTotals();
  showNotification("Repair added to invoice", "success");
}

// Close repair invoice modal
function closePOSRepairInvoiceModal() {
  const modal = document.getElementById("pos-repair-invoice-modal");
  if (modal) {
    modal.remove();
  }
}

// Finalize repair invoice and add to cart
function finalizeRepairInvoice(repairId) {
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) {
    showNotification("Repair not found", "error");
    return;
  }

  // Update invoice before finalizing
  handleUpdatePOSRepairInvoice(repairId);

  // Calculate total
  const total = (repair.items || []).reduce(
    (sum, item) => sum + (parseFloat(item.price) || 0),
    0
  );

  if (total <= 0) {
    showNotification("Please add items with valid prices", "error");
    return;
  }

  // Add to cart
  const cartItem = {
    id: `repair_${repairId}`,
    name: `Repair: ${repair.device} - ${repair.issue}`,
    type: "repair",
    repairId: repairId,
    customer: repair.customer || "",
    phone: repair.phone || "",
    device: repair.device || "",
    imei: repair.imei || "",
    issue: repair.issue || "",
    items: repair.items || [],
    price: total,
    quantity: 1,
    totalPrice: total,
  };

  // Check if already in cart
  const existingIndex = cart.findIndex((item) => item.id === cartItem.id);
  if (existingIndex !== -1) {
    cart[existingIndex] = cartItem; // Update existing
    showNotification("Repair invoice updated in cart", "success");
  } else {
    cart.push(cartItem);
    showNotification("Repair invoice added to cart", "success");
  }

  updateCartDisplay();
  closePOSRepairInvoiceModal();
}

// View repair invoice from cart
function viewRepairInvoice(repairId) {
  openPOSRepairInvoice(repairId);
}

// Print repair invoice
function printPOSRepairInvoice(repairId) {
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) return;

  // Update invoice before printing
  handleUpdatePOSRepairInvoice(repairId);

  const printWindow = window.open("", "_blank");
  const total = (repair.items || []).reduce(
    (sum, it) => sum + (parseFloat(it.price) || 0),
    0
  );
  const rowsHtml = (repair.items || [])
    .map(
      (item) =>
        `<tr><td>${item.lineNo}</td><td>${
          item.name
        }</td><td class="pricing-cell">${parseFloat(
          item.price
        ).toLocaleString()}</td></tr>`
    )
    .join("");

  printWindow.document.write(`<!DOCTYPE html>
<html>
<head>
  <title>Repair Invoice - ${repair.id}</title>
  <style>
    body{font-family:Arial,Helvetica,sans-serif;padding:24px;font-size:12px;}
    h1{font-size:18px;margin:0 0 12px;font-weight:600;}
    table{width:100%;border-collapse:collapse;margin-top:12px;}
    th,td{border:1px solid #ccc;padding:6px;text-align:left;}
    th{background:#f5f5f5;}
    .pricing-cell{text-align:right;}
  </style>
</head>
<body>
  <h1>Repair Invoice - ${repair.id}</h1>
  <table>
    <tr><th>Customer</th><td>${repair.customer || "-"}</td></tr>
    <tr><th>Phone</th><td>${repair.phone || "-"}</td></tr>
    <tr><th>Device</th><td>${repair.device || "-"}</td></tr>
    <tr><th>IMEI</th><td>${repair.imei || "-"}</td></tr>
    <tr><th>Issue</th><td>${repair.issue || "-"}</td></tr>
  </table>
  
  <table>
    <thead>
      <tr><th>#</th><th>Item</th><th>Pricing (Rs.)</th></tr>
    </thead>
    <tbody>
      ${
        rowsHtml ||
        '<tr><td colspan="3" style="text-align:center;color:#666;">No items</td></tr>'
      }
    </tbody>
    <tfoot>
      <tr><td colspan="2" style="font-weight:600">Total</td><td style="font-weight:600;text-align:right">${total.toLocaleString()}</td></tr>
    </tfoot>
  </table>
  
  <div style="text-align:right;font-weight:600;margin-top:6px;">Total: Rs.${total.toLocaleString()}</div>
</body>
</html>`);

  printWindow.document.close();
  printWindow.focus();
  printWindow.print();
}

// Finalize repair invoice and add to cart
function finalizeRepairInvoice(repairId) {
  closePOSRepairInvoiceModal();
  addRepairToCart(repairId);
}

// Add repair to cart
function addRepairToCart(repairId) {
  // Get repair data from global repairs data
  const repairsData = window.currentRepairsData || [];
  const repair = repairsData.find((r) => r.id === repairId);
  if (!repair) {
    showNotification("Repair not found", "error");
    return;
  }

  // Check if repair is already in cart
  const existingItem = cart.find(
    (item) => item.type === "repair" && item.repairId === repairId
  );
  if (existingItem) {
    showNotification("Repair already added to cart", "warning");
    return;
  }

  // Create cart item for repair
  const cartItem = {
    id: `repair_${repairId}`,
    type: "repair",
    repairId: repairId,
    name: `Repair: ${repair.device} - ${repair.issue}`,
    price: repair.estimatedCost || repair.actualCost || 0,
    quantity: 1,
    customer: repair.customer,
    phone: repair.phone,
    repair: repair, // Store full repair data for invoice generation
    total: repair.estimatedCost || repair.actualCost || 0,
    totalPrice: repair.estimatedCost || repair.actualCost || 0,
  };

  cart.push(cartItem);
  updateCartDisplay();
  showNotification(`Repair ${repairId} added to cart`, "success");

  // Auto-select customer if not already selected
  if (!currentCustomer && repair.customer) {
    currentCustomer = {
      name: repair.customer,
      phone: repair.phone,
      email: repair.email || "",
    };
    document.getElementById("customer-search").value = repair.customer;
    showNotification(`Customer ${repair.customer} auto-selected`, "info");
  }
}

// Add product to cart (for row click)
function addProductToCart(product) {
  if (product.stock <= 0) {
    showNotification("Product is out of stock", "error");
    return;
  }

  // Check if product is already in cart
  const existingItem = cart.find(
    (item) => item.type === "product" && item.id === product.id
  );
  if (existingItem) {
    // Increase quantity if in stock
    if (existingItem.quantity < product.stock) {
      existingItem.quantity++;
      updateCartDisplay();
      showNotification(`Increased ${product.name} quantity`, "success");
    } else {
      showNotification("Maximum stock quantity reached", "warning");
    }
    return;
  }

  // Add new item to cart
  const cartItem = {
    id: product.id,
    type: "product",
    name: product.name,
    price: product.price,
    quantity: 1,
    stock: product.stock,
    product: product, // Store full product data
  };

  cart.push(cartItem);
  updateCartDisplay();
  showNotification(`${product.name} added to cart`, "success");
}

// View product details popup
function viewProductDetails(productId) {
  const product = posProducts.find((p) => p.id === productId);
  if (!product) {
    showNotification("Product not found", "error");
    return;
  }

  const stockStatus =
    product.stock > 10
      ? "In Stock"
      : product.stock > 0
      ? "Low Stock"
      : "Out of Stock";
  const stockClass =
    product.stock > 10
      ? "text-green-600"
      : product.stock > 0
      ? "text-yellow-600"
      : "text-red-600";

  // Create modal content
  const modalContent = `
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onclick="closeProductModal()">
            <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4" onclick="event.stopPropagation()">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Product Details</h2>
                    <button onclick="closeProductModal()" class="text-gray-500 hover:text-gray-700">
                        <i data-feather="x" class="w-5 h-5"></i>
                    </button>
                </div>
                
                <div class="space-y-3">
                    <div>
                        <span class="font-semibold text-gray-600">Name:</span>
                        <span class="ml-2 text-gray-800">${product.name}</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">SKU:</span>
                        <span class="ml-2 text-gray-800">${product.sku}</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">Category:</span>
                        <span class="ml-2 text-gray-800">${
                          product.category
                        }</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">Brand:</span>
                        <span class="ml-2 text-gray-800">${product.brand}</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">Price:</span>
                        <span class="ml-2 text-blue-600 font-medium">Rs.${product.price.toLocaleString()}</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">Stock:</span>
                        <span class="ml-2 ${stockClass} font-medium">${stockStatus} (${
    product.stock
  } units)</span>
                    </div>
                    <div>
                        <span class="font-semibold text-gray-600">Barcode:</span>
                        <span class="ml-2 text-gray-800 font-mono">${
                          product.barcode
                        }</span>
                    </div>
                </div>
                
                <div class="mt-6 flex justify-end space-x-2">
                    <button onclick="closeProductModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">
                        Close
                    </button>
                    ${
                      product.stock > 0
                        ? `<button onclick="addProductToCart(${JSON.stringify(
                            product
                          ).replace(
                            /"/g,
                            "&quot;"
                          )}); closeProductModal();" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                            Add to Cart
                        </button>`
                        : ""
                    }
                </div>
            </div>
        </div>
    `;

  // Add modal to page
  const modalDiv = document.createElement("div");
  modalDiv.id = "product-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  // Initialize feather icons
  feather.replace();
}

// Close product modal
function closeProductModal() {
  const modal = document.getElementById("product-modal");
  if (modal) {
    modal.remove();
  }
}

// Refresh repairs list
function refreshRepairsList() {
  loadPOSRepairs();
  showNotification("Repair list refreshed", "success");
}

// View repair invoice from cart
function viewRepairInvoice(repairId) {
  const cartItem = cart.find(
    (item) => item.type === "repair" && item.repairId === repairId
  );
  if (!cartItem || !cartItem.repair) {
    showNotification("Repair data not found", "error");
    return;
  }

  const repair = cartItem.repair;

  // Generate and print repair invoice
  const printWindow = window.open("", "_blank");
  const total = repair.estimatedCost || repair.actualCost || 0;

  const itemsHtml = (repair.items || [])
    .map(
      (item) =>
        `<tr><td>${
          item.name
        }</td><td class="text-right">₹${item.price.toLocaleString()}</td></tr>`
    )
    .join("");

  const html = `
    <html>
    <head>
        <title>Repair Invoice - ${repair.id}</title>
        <style>
            body { font-family: Arial, sans-serif; padding: 20px; font-size: 12px; }
            h1 { font-size: 18px; margin: 0 0 20px; font-weight: 600; }
            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
            th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
            th { background: #f5f5f5; font-weight: 600; }
            .text-right { text-align: right; }
            .total-row { font-weight: 600; background: #f9f9f9; }
        </style>
    </head>
    <body>
        <h1>Thilina Mobiles - Repair Invoice</h1>
        <table>
            <tr><th>Repair ID</th><td>${repair.id}</td></tr>
            <tr><th>Customer</th><td>${repair.customer}</td></tr>
            <tr><th>Phone</th><td>${repair.phone}</td></tr>
            <tr><th>Device</th><td>${repair.device}</td></tr>
            <tr><th>IMEI</th><td>${repair.imei || "N/A"}</td></tr>
            <tr><th>Issue</th><td>${repair.issue}</td></tr>
            <tr><th>Technician</th><td>${repair.technician}</td></tr>
            <tr><th>Received Date</th><td>${repair.receivedDate}</td></tr>
            ${
              repair.completedDate
                ? `<tr><th>Completed Date</th><td>${repair.completedDate}</td></tr>`
                : ""
            }
        </table>
        
        ${
          (repair.items || []).length > 0
            ? `
        <h2 style="margin-top: 25px; font-size: 16px;">Parts & Labor</h2>
        <table>
            <thead>
                <tr><th>Description</th><th class="text-right">Amount</th></tr>
            </thead>
            <tbody>
                ${itemsHtml}
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td>Total Amount</td>
                    <td class="text-right">₹${total.toLocaleString()}</td>
                </tr>
            </tfoot>
        </table>
        `
            : `
        <h2 style="margin-top: 25px; font-size: 16px;">Repair Cost</h2>
        <table>
            <tr class="total-row">
                <td>Total Repair Cost</td>
                <td class="text-right">₹${total.toLocaleString()}</td>
            </tr>
        </table>
        `
        }
        
        <div style="margin-top: 30px; text-align: center; font-size: 10px; color: #666;">
            Thank you for choosing Thilina Mobiles!
        </div>
    </body>
    </html>`;

  printWindow.document.write(html);
  printWindow.document.close();
  printWindow.print();
}

// ==================== CUSTOMER SEARCH FUNCTIONALITY ====================

// Handle customer search input
function handleCartCustomerSearch() {
  const input = document.getElementById("customer-search");
  const resultsDiv = document.getElementById("customer-results");

  if (!input || !resultsDiv) {
    console.error("Customer search elements not found");
    return;
  }

  const searchTerm = input.value.toLowerCase().trim();

  if (searchTerm.length < 1) {
    resultsDiv.innerHTML = "";
    resultsDiv.classList.add("hidden");
    return;
  }

  // Filter customers based on search term
  const filteredCustomers = customers.filter(
    (customer) =>
      customer.name.toLowerCase().includes(searchTerm) ||
      customer.phone.includes(searchTerm) ||
      customer.email.toLowerCase().includes(searchTerm)
  );

  // Display results
  if (filteredCustomers.length > 0) {
    resultsDiv.innerHTML = filteredCustomers
      .map(
        (customer) => `
            <div class="customer-result p-2 hover:bg-gray-100 cursor-pointer border-b" 
                 onclick="selectCustomer(${
                   customer.id
                 }, '${customer.name.replace(/'/g, "\\'")}', '${
          customer.phone
        }', '${customer.email.replace(/'/g, "\\'")}')">
                <div class="font-medium text-gray-900">${customer.name}</div>
                <div class="text-sm text-gray-600">${customer.phone} • ${
          customer.email
        }</div>
            </div>
        `
      )
      .join("");
    resultsDiv.classList.remove("hidden");
  } else {
    resultsDiv.innerHTML =
      '<div class="p-2 text-gray-500 text-sm">No customers found</div>';
    resultsDiv.classList.remove("hidden");
  }
}

// Select a customer from search results
function selectCustomer(id, name, phone, email) {
  document.getElementById("customer-search").value = name;
  document.getElementById("selected-customer-id").value = id;
  document.getElementById("customer-results").classList.add("hidden");

  // Update the current sale customer info if needed
  if (currentSale.customer) {
    currentSale.customer = { id, name, phone, email };
  }
}

// Setup customer search event listener
document.addEventListener("DOMContentLoaded", function () {
  const customerSearchInput = document.getElementById("customer-search");
  if (customerSearchInput) {
    customerSearchInput.addEventListener("input", handleCustomerSearch);

    // Hide results when clicking outside
    document.addEventListener("click", function (e) {
      if (
        !customerSearchInput.contains(e.target) &&
        !document.getElementById("customer-results").contains(e.target)
      ) {
        document.getElementById("customer-results").classList.add("hidden");
      }
    });
  }
});
