// Show add repair modal
function showAddRepairModal() {
  document.getElementById("addRepairModal").classList.remove("hidden");
  // Clear form
  document.getElementById("repairCustomerName").value = "";
  document.getElementById("repairCustomerPhone").value = "";
  document.getElementById("repairDeviceModel").value = "";
  document.getElementById("repairDeviceBrand").value = "";
  document.getElementById("repairIssue").value = "";
  document.getElementById("repairEstimatedCost").value = "";
