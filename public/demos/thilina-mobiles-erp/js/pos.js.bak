// Switch POS Tab Function
function switchPOSTab(tab) {
  currentPOSTab = tab;

  // Hide all views
  document.getElementById("products-view")?.classList.add("hidden");
  document.getElementById("repairs-view")?.classList.add("hidden");
  document.getElementById("customer-view")?.classList.add("hidden");
  document.getElementById("return-view")?.classList.add("hidden");

  // Remove active class from all tabs
  document.querySelectorAll(".pos-tab").forEach((btn) => {
    btn.classList.remove("active", "border-blue-500", "text-blue-600");
    btn.classList.add("border-transparent", "text-gray-500");
  });

  // Activate selected tab
  const activeTab = document.getElementById(`tab-${tab}`);
  if (activeTab) {
    activeTab.classList.add("active", "border-blue-500", "text-blue-600");
    activeTab.classList.remove("border-transparent", "text-gray-500");
  }

  // Show appropriate content and update UI
  switch (tab) {
    case "shop":
      document.getElementById("products-view")?.classList.remove("hidden");
      document.getElementById("section-title").textContent = "Shop";
      document
        .getElementById("search-filters-section")
        ?.classList.remove("hidden");
      document.getElementById("cart-area")?.classList.remove("hidden");
      loadProducts();
      clearCartForTabSwitch();
      updateUIForShopMode();
      break;

    case "repair":
      document.getElementById("repairs-view")?.classList.remove("hidden");
      document.getElementById("section-title").textContent = "Repair Orders";
      document
        .getElementById("search-filters-section")
        ?.classList.add("hidden");
      document.getElementById("cart-area")?.classList.remove("hidden");
      loadPOSRepairs();
      clearCartForTabSwitch();
      updateUIForRepairMode();
      break;

    case "customer":
      document.getElementById("customer-view")?.classList.remove("hidden");
      document.getElementById("section-title").textContent = "Customers";
      document
        .getElementById("search-filters-section")
        ?.classList.add("hidden");
      document.getElementById("cart-area")?.classList.add("hidden");
      loadCustomerTable();
      clearCartForTabSwitch();
      updateUIForCustomerMode();
      break;

    case "return":
      document.getElementById("return-view")?.classList.remove("hidden");
      document.getElementById("section-title").textContent = "Returns";
      document
        .getElementById("search-filters-section")
        ?.classList.add("hidden");
      document.getElementById("cart-area")?.classList.add("hidden");
      loadReturnTable();
      clearCartForTabSwitch();
      updateUIForReturnMode();
      break;
  }

  // Re-initialize feather icons
  feather.replace();
}

// Load and display products in table format
function loadProducts(productsToShow = posProducts) {
  const tbody = document.getElementById("product-table-body");
  if (!tbody) return;

  tbody.innerHTML = "";

  productsToShow.forEach((product) => {
    const row = createProductRow(product);
    tbody.appendChild(row);
  });

  // Initialize feather icons for action buttons
  feather.replace();
}

// Create product row element
function createProductRow(product) {
  const row = document.createElement("tr");
  row.className = "hover:bg-gray-50 cursor-pointer";

  const stockStatus =
    product.stock > 10
      ? "in-stock"
      : product.stock > 0
      ? "low-stock"
      : "out-of-stock";
  const stockText =
    product.stock > 10
      ? "In Stock"
      : product.stock > 0
      ? "Low Stock"
      : "Out of Stock";
  const stockClass =
    stockStatus === "in-stock"
      ? "bg-green-100 text-green-800"
      : stockStatus === "low-stock"
      ? "bg-yellow-100 text-yellow-800"
      : "bg-red-100 text-red-800";

  row.innerHTML = `
        <td class="px-3 py-2 text-sm text-gray-900">${product.name}</td>
        <td class="px-3 py-2 text-sm text-gray-600">${product.category}</td>
        <td class="px-3 py-2 text-sm text-gray-600">${product.brand}</td>
        <td class="px-3 py-2 text-sm font-medium text-blue-600">Rs.${product.price.toLocaleString()}</td>
        <td class="px-3 py-2">
            <span class="px-2 py-1 text-xs font-semibold rounded-full ${stockClass}">${stockText} (${
    product.stock
  })</span>
        </td>
        <td class="px-3 py-2" onclick="event.stopPropagation()">
            <button onclick="viewProductDetails(${
              product.id
            })" class="text-blue-600 hover:text-blue-900 p-1 rounded" title="View Details">
                <i data-feather="eye" class="w-4 h-4"></i>
            </button>
        </td>
    `;

  // Add click handler to row for adding to cart
  row.onclick = () => addProductToCart(product);

  return row;
}

