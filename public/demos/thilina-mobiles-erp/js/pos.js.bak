    completed: "bg-green-100 text-green-800",
    delivered: "bg-gray-100 text-gray-800",
    pending_parts: "bg-red-100 text-red-800",
  };

  const statusLabels = {
    received: "Received",
    diagnosing: "Diagnosing",
    repairing: "Repairing",
    testing: "Testing",
    completed: "Completed",
    delivered: "Delivered",
    pending_parts: "Pending Parts",
  };

  dataToShow.forEach((repair) => {
    const row = document.createElement("tr");
    row.className = "hover:bg-gray-50 cursor-pointer";

    const statusClass =
      statusColors[repair.status] || "bg-gray-100 text-gray-800";
    const statusLabel = statusLabels[repair.status] || repair.status;

    row.innerHTML = `
            <td class="px-3 py-2 text-sm font-medium text-blue-600">${
              repair.id
            }</td>
            <td class="px-3 py-2 text-sm text-gray-900">${repair.device}</td>
            <td class="px-3 py-2 text-sm text-gray-700">${repair.customer}</td>
            <td class="px-3 py-2 text-sm text-gray-600">${repair.issue}</td>
            <td class="px-3 py-2">
                <span class="px-2 py-1 text-xs font-semibold rounded-full ${statusClass}">${statusLabel}</span>
            </td>
            <td class="px-3 py-2 text-sm text-gray-900">Rs.${repair.estimatedCost.toLocaleString()}</td>
            <td class="px-3 py-2 text-sm font-medium">
                <button onclick="event.stopPropagation(); viewPOSRepair('${
                  repair.id
                }')" class="text-blue-600 hover:text-blue-900 mr-3 p-1 rounded" title="View Details">
                    <i data-feather="eye" class="w-4 h-4"></i>
                </button>
                <button onclick="event.stopPropagation(); editPOSRepair('${
                  repair.id
                }')" class="text-green-600 hover:text-green-900 mr-3 p-1 rounded" title="Edit Repair">
                    <i data-feather="edit" class="w-4 h-4"></i>
                </button>
                <button onclick="event.stopPropagation(); openPOSRepairInvoice('${
                  repair.id
                }')" class="text-purple-600 hover:text-purple-900 p-1 rounded" title="Invoice">
                    <i data-feather="printer" class="w-4 h-4"></i>
                </button>
            </td>
        `;

    // Add click handler to row for adding to cart
    row.onclick = () => addRepairToCart(repair.id);

    tbody.appendChild(row);
  });

  // Initialize feather icons for action buttons
  feather.replace();

  // Store repairs data globally for filtering
  window.currentRepairsData = repairsData;
}

// Toggle between products and repairs view
function toggleView() {
  const productsView = document.getElementById("products-view");
  const repairsView = document.getElementById("repairs-view");
  const toggleBtn = document.getElementById("toggle-view-btn");
  const toggleIcon = document.getElementById("toggle-icon");
  const toggleText = document.getElementById("toggle-text");
  const sectionTitle = document.getElementById("section-title");

  if (currentView === "products") {
    // Switch to repairs view
    currentView = "repairs";
    productsView.classList.add("hidden");
    repairsView.classList.remove("hidden");
    toggleIcon.setAttribute("data-feather", "shopping-bag");
    toggleText.textContent = "Shop";
    sectionTitle.textContent = "Repair Orders";
    toggleBtn.classList.remove("bg-purple-500", "hover:bg-purple-600");
    toggleBtn.classList.add("bg-green-500", "hover:bg-green-600");
    loadPOSRepairs();

    // Clear cart and update UI for repairs
    clearCartForTabSwitch();
    updateUIForRepairMode();
  } else {
    // Switch to products view
    currentView = "products";
    productsView.classList.remove("hidden");
    repairsView.classList.add("hidden");
    toggleIcon.setAttribute("data-feather", "tool");
    toggleText.textContent = "Repairs";
    sectionTitle.textContent = "Products";
    toggleBtn.classList.remove("bg-green-500", "hover:bg-green-600");
    toggleBtn.classList.add("bg-purple-500", "hover:bg-purple-600");
    loadProducts();

    // Clear cart and update UI for shop
    clearCartForTabSwitch();
    updateUIForShopMode();
  }

  // Re-initialize feather icons
  feather.replace();
}

// Filter items (products or repairs based on current view)
function filterItems() {
  const searchTerm = document.getElementById("item-search").value.toLowerCase();

  if (currentView === "products") {
    filterProducts(searchTerm);
  } else {
    filterRepairsInline(searchTerm);
  }
}

// Filter products
function filterProducts(searchTerm) {
  const filteredProducts = posProducts.filter(
    (product) =>
      product.name.toLowerCase().includes(searchTerm) ||
      product.category.toLowerCase().includes(searchTerm) ||
      product.brand.toLowerCase().includes(searchTerm)
  );
  loadProducts(filteredProducts);
}

// Filter repairs inline
function filterRepairsInline(searchTerm) {
  const statusFilter =
    document.getElementById("repair-status-filter")?.value || "";

  if (!window.currentRepairsData) return;

  const filteredRepairs = window.currentRepairsData.filter((repair) => {
    const matchesSearch =
      !searchTerm ||
      repair.id.toLowerCase().includes(searchTerm) ||
      repair.device.toLowerCase().includes(searchTerm) ||
      repair.customer.toLowerCase().includes(searchTerm) ||
      repair.issue.toLowerCase().includes(searchTerm);

    const matchesStatus = !statusFilter || repair.status === statusFilter;

    return matchesSearch && matchesStatus;
  });

  loadPOSRepairs(filteredRepairs);
}

// Update UI for customer mode
function updateUIForCustomerMode() {
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) cartHeader.textContent = "Customer Details";

  updateEmptyCartMessage("customer");

  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) discountRow.style.display = "none";

  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="user-check" class="w-5 h-5 mr-2 inline"></i>Select Customer';
    feather.replace();
  }
}

// Update UI for return mode
function updateUIForReturnMode() {
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) cartHeader.textContent = "Return Details";

  updateEmptyCartMessage("return");

  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) discountRow.style.display = "none";

  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="rotate-ccw" class="w-5 h-5 mr-2 inline"></i>Process Return';
    feather.replace();
  }
}

// Update empty cart message based on mode
function updateEmptyCartMessage(mode) {
  const emptyCart = document.getElementById("empty-cart");
  if (emptyCart && cart.length === 0) {
    if (mode === "repair") {
      emptyCart.innerHTML = `
        <i data-feather="tool" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No repair selected</p>
        <p class="text-sm">Select a repair order to create invoice</p>
      `;
    } else if (mode === "customer") {
      emptyCart.innerHTML = `
        <i data-feather="users" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No customer selected</p>
        <p class="text-sm">Select a customer to view details</p>
      `;
    } else if (mode === "return") {
      emptyCart.innerHTML = `
        <i data-feather="rotate-ccw" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No return selected</p>
        <p class="text-sm">Select a return to process</p>
      `;
    } else {
      emptyCart.innerHTML = `
        <i data-feather="shopping-cart" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>Your cart is empty</p>
        <p class="text-sm">Add products to get started</p>
      `;
    }
    feather.replace();
  }
}

// Create product card element
function createProductCard(product) {
  const card = document.createElement("div");
  card.className =
    "pos-product-card bg-white border border-gray-200 rounded-lg p-3 shadow-sm";

  const stockStatus =
    product.stock > 10
      ? "in-stock"
      : product.stock > 0
      ? "low-stock"
      : "out-of-stock";
  const stockText =
    product.stock > 10
      ? "In Stock"
      : product.stock > 0
      ? "Low Stock"
      : "Out of Stock";

  if (product.stock === 0) {
    card.classList.add("out-of-stock");
  } else {
    card.onclick = () => addToCart(product);
  }

  card.innerHTML = `
        <div class="aspect-square bg-gray-100 rounded-lg mb-3 overflow-hidden relative">
            <img src="${product.image}" alt="${product.name}" 
                 class="w-full h-full object-cover" 
                 onerror="this.src='${placeholderImages.noimage}'">
            ${
              product.stock === 0
                ? '<div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center"><span class="text-white text-sm font-medium">Out of Stock</span></div>'
                : ""
            }
        </div>
        <div class="space-y-2">
            <h3 class="font-medium text-sm text-gray-800 leading-tight">${
              product.name
            }</h3>
            <p class="text-xs text-gray-500">${product.sku}</p>
            <div class="flex justify-between items-center">
                <span class="text-base font-bold text-blue-600">Rs.${product.price.toLocaleString()}</span>
                <span class="stock-indicator ${stockStatus}">${stockText}</span>
            </div>
            <div class="text-xs text-gray-500 text-center">
                ${product.stock} units available
            </div>
        </div>
    `;

  return card;
}

// Filter products
function filterProducts() {
  const searchTerm = document
    .getElementById("product-search")
    .value.toLowerCase();
  const categoryFilter = document.getElementById("category-filter").value;
  const brandFilter = document.getElementById("brand-filter").value;

  const filteredProducts = posProducts.filter((product) => {
    const matchesSearch =
      product.name.toLowerCase().includes(searchTerm) ||
      product.sku.toLowerCase().includes(searchTerm) ||
      product.barcode.includes(searchTerm);
    const matchesCategory =
      !categoryFilter || product.category === categoryFilter;
    const matchesBrand = !brandFilter || product.brand === brandFilter;

    return matchesSearch && matchesCategory && matchesBrand;
  });

  loadProducts(filteredProducts);
}

// Clear filters
function clearFilters() {
  document.getElementById("product-search").value = "";
  document.getElementById("category-filter").value = "";
  document.getElementById("brand-filter").value = "";
  loadProducts();
}

// Add product by barcode
function addProductByBarcode(barcode) {
  const product = posProducts.find(
    (p) =>
      p.barcode === barcode || p.sku.toLowerCase() === barcode.toLowerCase()
  );
  if (product) {
    addToCart(product);
    showNotification(`${product.name} added to cart`, "success");
  } else {
    showNotification("Product not found", "error");
  }
}

// Add product to cart
function addToCart(product) {
  if (product.stock <= 0) {
    showNotification("Product is out of stock", "error");
    return;
  }

  const existingItem = cart.find((item) => item.id === product.id);

  if (existingItem) {
    if (existingItem.quantity < product.stock) {
      existingItem.quantity++;
      existingItem.total = existingItem.quantity * existingItem.price;
      existingItem.totalPrice = existingItem.total;
    } else {
      showNotification("Not enough stock available", "error");
      return;
    }
  } else {
    cart.push({
      id: product.id,
      name: product.name,
      sku: product.sku,
      price: product.price,
      quantity: 1,
      total: product.price,
      totalPrice: product.price,
      stock: product.stock,
    });
  }

  updateCartDisplay();
  showNotification(`${product.name} added to cart`, "success");
}

// Remove item from cart
function removeFromCart(productId) {
  // normalize id types: if productId is numeric string, convert to number
  const normalizedId =
    typeof productId === "string" && /^\d+$/.test(productId)
      ? Number(productId)
      : productId;

  console.debug(
    "removeFromCart: before",
    cart.map((i) => i.id)
  );
  cart = cart.filter((item) => item.id !== normalizedId);
  console.debug(
    "removeFromCart: after",
    cart.map((i) => i.id)
  );
  updateCartDisplay();
}

// Update item quantity
function updateQuantity(productId, newQuantity) {
  // normalize incoming id (DOM calls often pass numeric ids as strings)
  const normalizedId =
    typeof productId === "string" && /^\d+$/.test(productId)
      ? Number(productId)
      : productId;

  const item = cart.find((item) => item.id === normalizedId);
  if (item) {
    if (newQuantity <= 0) {
      removeFromCart(productId);
    } else if (newQuantity <= item.stock) {
      item.quantity = newQuantity;
      item.total = item.quantity * item.price;
      item.totalPrice = item.total;
      console.debug("updateQuantity:", {
        id: normalizedId,
        quantity: item.quantity,
        total: item.total,
      });
      updateCartDisplay();
    } else {
      showNotification("Not enough stock available", "error");
    }
  }
}

// Update cart display
function updateCartDisplay() {
  const cartItemsContainer = document.getElementById("cart-items");
  if (!cartItemsContainer) {
    console.error("updateCartDisplay: #cart-items element not found");
    return;
  }

  let emptyCart = document.getElementById("empty-cart");
  if (!emptyCart) {
    // create a fallback empty cart element so code can run without HTML present
    emptyCart = document.createElement("div");
    emptyCart.id = "empty-cart";
    emptyCart.className = "p-4 text-center text-gray-500";
    emptyCart.textContent = "No items in cart";
  }

  if (cart.length === 0) {
    emptyCart.style.display = "block";
    cartItemsContainer.innerHTML = "";
    cartItemsContainer.appendChild(emptyCart);
  } else {
    // ensure emptyCart hidden when there are items
    try {
      emptyCart.style.display = "none";
    } catch (e) {}

    cartItemsContainer.innerHTML = "";

    cart.forEach((item) => {
      const cartItem = createCartItem(item);
      cartItemsContainer.appendChild(cartItem);
    });
  }

  updateTotals();
}

// Create cart item element
function createCartItem(item) {
  const cartItem = document.createElement("div");
  cartItem.className =
    "flex items-center justify-between p-3 border-b border-gray-100 last:border-b-0";

  // Different display for repair items vs product items
  if (item.type === "repair") {
    cartItem.innerHTML = `
        <div class="flex-1">
            <h4 class="font-medium text-sm text-gray-800">${item.name}</h4>
            <p class="text-xs text-blue-500">Repair ID: ${item.repairId}</p>
            <p class="text-xs text-gray-500">Customer: ${item.customer}</p>
            <p class="text-sm font-semibold text-purple-600">Rs.${item.price.toLocaleString()}</p>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="viewRepairInvoice('${item.repairId}')" 
                    class="px-2 py-1 bg-blue-100 text-blue-600 rounded text-xs hover:bg-blue-200">Invoice</button>
            <button onclick="removeFromCart('${item.id}')" 
                    class="w-6 h-6 bg-red-100 text-red-600 rounded text-xs hover:bg-red-200">×</button>
        </div>
    `;
  } else {
    // Original product item display
    cartItem.innerHTML = `
        <div class="flex-1">
            <h4 class="font-medium text-sm text-gray-800">${item.name}</h4>
            <p class="text-xs text-gray-500">${item.sku || ""}</p>
            <p class="text-sm font-semibold text-blue-600">Rs.${item.price.toLocaleString()}</p>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="updateQuantity('${item.id}', ${
      item.quantity - 1
    })" 
                    class="w-6 h-6 bg-gray-200 rounded text-xs hover:bg-gray-300">-</button>
            <input type="number" value="${item.quantity}" min="1" max="${
      item.stock || 99
    }"
                   onchange="updateQuantity('${item.id}', parseInt(this.value))"
                   class="w-12 px-1 py-1 text-xs text-center border border-gray-300 rounded">
            <button onclick="updateQuantity('${item.id}', ${
      item.quantity + 1
    })" 
                    class="w-6 h-6 bg-gray-200 rounded text-xs hover:bg-gray-300">+</button>
            <button onclick="removeFromCart('${item.id}')" 
                    class="w-6 h-6 bg-red-100 text-red-600 rounded text-xs hover:bg-red-200 ml-2">×</button>
        </div>
    `;
  }

  return cartItem;
}

// Update totals
function updateTotals() {
  const subtotal = cart.reduce(
    (sum, item) =>
      sum + (item.totalPrice || item.total || item.price * item.quantity),
    0
  );

  console.debug(
    "updateTotals: subtotal=",
    subtotal,
    "cart=",
    cart.map((i) => ({
      id: i.id,
      qty: i.quantity,
      price: i.price,
      total: i.total,
      totalPrice: i.totalPrice,
    }))
  );

  const discountInput = document.getElementById("discount-input");
  const discountType = document.getElementById("discount-type");
  const discountValue = parseFloat(discountInput.value) || 0;

  let discountAmount = 0;
  if (discountValue > 0) {
    if (discountType.value === "percentage") {
      discountAmount = (subtotal * discountValue) / 100;
    } else {
      discountAmount = discountValue;
    }
  }

  const afterDiscount = subtotal - discountAmount;
  const total = afterDiscount; // No tax

  document.getElementById(
    "subtotal"
  ).textContent = `Rs.${subtotal.toLocaleString()}`;
  document.getElementById("total").textContent = `Rs.${total.toLocaleString()}`;

  // Update editable total field with calculated value (Subtotal - Discount)
  const totalEditable = document.getElementById("total-editable");
  if (totalEditable) {
    totalEditable.value = total.toFixed(2);
  }

  // Update change calculation if cash payment
  if (currentPaymentMethod === "cash") {
    calculateChange();
  }
}

// Calculate change for cash payment
function calculateChange() {
  // Use editable total if available, otherwise fall back to display total
  const totalEditable = document.getElementById("total-editable");
  const total = totalEditable
    ? parseFloat(totalEditable.value) || 0
    : parseFloat(
        document
          .getElementById("total")
          .textContent.replace("Rs.", "")
          .replace(/,/g, "")
      );
  const cashReceived =
    parseFloat(document.getElementById("cash-received").value) || 0;
  const change = cashReceived - total;

  document.getElementById("change").textContent = `Rs.${Math.max(
    0,
    change
  ).toLocaleString()}`;
  document.getElementById("change").className =
    change >= 0 ? "font-semibold text-green-600" : "font-semibold text-red-600";
}

// Select payment method
function selectPaymentMethod(method) {
  currentPaymentMethod = method;

  // Update button styles
  document.querySelectorAll(".payment-method-btn").forEach((btn) => {
    btn.classList.remove(
      "active",
      "bg-blue-500",
      "text-white",
      "border-blue-500"
    );
    btn.classList.add("bg-gray-100", "text-gray-700", "border-gray-300");
  });

  const activeBtn = document.querySelector(`[data-method="${method}"]`);
  activeBtn.classList.remove("bg-gray-100", "text-gray-700", "border-gray-300");
  activeBtn.classList.add(
    "active",
    "bg-blue-500",
    "text-white",
    "border-blue-500"
  );

  // Show/hide payment sections
  document.getElementById("cash-payment").style.display =
    method === "cash" ? "block" : "none";
  document.getElementById("card-payment").style.display =
    method === "card" ? "block" : "none";
}

// Clear cart
function clearCart() {
  cart = [];
  updateCartDisplay();
  showNotification("Cart cleared", "info");
}

// Clear cart when switching tabs (without notification)
function clearCartForTabSwitch() {
  cart = [];
  currentCustomer = null;

  const customerSearch = document.getElementById("customer-search");
  if (customerSearch) customerSearch.value = "";

  const selectedCustomerId = document.getElementById("selected-customer-id");
  if (selectedCustomerId) selectedCustomerId.value = "";

  const customerSelectedInfo = document.getElementById(
    "customer-selected-info"
  );
  if (customerSelectedInfo) customerSelectedInfo.classList.add("hidden");

  const discountInput = document.getElementById("discount-input");
  if (discountInput) discountInput.value = "0";

  const cashReceived = document.getElementById("cash-received");
  if (cashReceived) cashReceived.value = "";

  updateCartDisplay();
}

// Update UI for repair mode
function updateUIForRepairMode() {
  // Update cart header
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) {
    cartHeader.textContent = "Repair Invoice";
  }

  // Update empty cart message
  updateEmptyCartMessage("repair");

  // Hide discount section for repairs
  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) {
    discountRow.style.display = "none";
  }

  // Update button text
  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="file-text" class="w-5 h-5 mr-2 inline"></i>Complete Repair Invoice';
    feather.replace();
  }
}

// Update UI for shop mode
function updateUIForShopMode() {
  // Update cart header
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) {
    cartHeader.textContent = "Shopping Cart";
  }

  // Update empty cart message
  updateEmptyCartMessage("shop");

  // Show discount section for shop
  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) {
    discountRow.style.display = "flex";
  }

  // Update button text
  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="credit-card" class="w-5 h-5 mr-2 inline"></i>Complete Sale';
    feather.replace();
  }
}

// Update empty cart message based on mode
function updateEmptyCartMessage(mode) {
  const emptyCart = document.getElementById("empty-cart");
  if (emptyCart && cart.length === 0) {
    if (mode === "repair") {
      emptyCart.innerHTML = `
        <i data-feather="tool" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No repair selected</p>
        <p class="text-sm">Select a repair order to create invoice</p>
      `;
    } else if (mode === "customer") {
      emptyCart.innerHTML = `
        <i data-feather="users" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No customer selected</p>
        <p class="text-sm">Select a customer to view details</p>
      `;
    } else if (mode === "return") {
      emptyCart.innerHTML = `
        <i data-feather="rotate-ccw" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>No return selected</p>
        <p class="text-sm">Select a return to process</p>
      `;
    } else {
      emptyCart.innerHTML = `
        <i data-feather="shopping-cart" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
        <p>Your cart is empty</p>
        <p class="text-sm">Add products to get started</p>
      `;
    }
    feather.replace();
  }
}

// Update UI for customer mode
function updateUIForCustomerMode() {
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) cartHeader.textContent = "Customer Details";

  updateEmptyCartMessage("customer");

  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) discountRow.style.display = "none";

  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="user-check" class="w-5 h-5 mr-2 inline"></i>Select Customer';
    feather.replace();
  }
}

// Update UI for return mode
function updateUIForReturnMode() {
  const cartHeader = document.getElementById("cart-header");
  if (cartHeader) cartHeader.textContent = "Return Details";

  updateEmptyCartMessage("return");

  const discountRow =
    document.getElementById("discount-input")?.parentElement?.parentElement;
  if (discountRow) discountRow.style.display = "none";

  const completeBtn = document.querySelector(
    "button[onclick='processPayment()']"
  );
  if (completeBtn) {
    completeBtn.innerHTML =
      '<i data-feather="rotate-ccw" class="w-5 h-5 mr-2 inline"></i>Process Return';
    feather.replace();
  }
}

// Load customer table
function loadCustomerTable(customersToShow = customerData) {
  const tbody = document.getElementById("customer-table-body");
  if (!tbody) return;

  tbody.innerHTML = "";

  customersToShow.forEach((customer) => {
    const row = document.createElement("tr");
    row.className = "hover:bg-gray-50 cursor-pointer";
    row.innerHTML = `
      <td class="px-3 py-2 text-sm font-medium text-gray-900">${
        customer.name
      }</td>
      <td class="px-3 py-2 text-sm text-gray-600">${customer.phone}</td>
      <td class="px-3 py-2 text-sm text-gray-600">${customer.email || "-"}</td>
      <td class="px-3 py-2 text-sm text-gray-900 font-medium">Rs. ${
        customer.totalPurchases?.toLocaleString() || "0"
      }</td>
      <td class="px-3 py-2" onclick="event.stopPropagation()">
        <button onclick="viewCustomerDetails(${
          customer.id
        })" class="text-blue-600 hover:text-blue-900 p-1 rounded" title="View Details">
          <i data-feather="eye" class="w-4 h-4"></i>
        </button>
        <button onclick="editCustomerDetails(${
          customer.id
        })" class="text-green-600 hover:text-green-900 p-1 rounded ml-2" title="Edit">
          <i data-feather="edit" class="w-4 h-4"></i>
        </button>
      </td>
    `;

    row.onclick = () => selectCustomerFromTable(customer.id);
    tbody.appendChild(row);
  });

  feather.replace();
}

// Load return table
function loadReturnTable(returnsToShow = returnData) {
  const tbody = document.getElementById("return-table-body");
  if (!tbody) return;

  tbody.innerHTML = "";

  returnsToShow.forEach((returnItem) => {
    const row = document.createElement("tr");
    row.className = "hover:bg-gray-50";

    const statusColor =
      returnItem.status === "Completed"
        ? "green"
        : returnItem.status === "Approved"
        ? "blue"
        : returnItem.status === "Pending"
        ? "yellow"
        : "red";

    row.innerHTML = `
      <td class="px-3 py-2 text-sm font-medium text-gray-900">${
        returnItem.id
      }</td>
      <td class="px-3 py-2 text-sm text-gray-600">${
        returnItem.invoiceNumber
      }</td>
      <td class="px-3 py-2 text-sm text-gray-600">${returnItem.customer}</td>
      <td class="px-3 py-2 text-sm text-gray-900">${returnItem.product}</td>
      <td class="px-3 py-2 text-sm text-gray-600">${returnItem.reason}</td>
      <td class="px-3 py-2 text-sm text-gray-900 font-medium">Rs. ${returnItem.amount.toLocaleString()}</td>
      <td class="px-3 py-2">
        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-${statusColor}-100 text-${statusColor}-800">
          ${returnItem.status}
        </span>
      </td>
      <td class="px-3 py-2">
        <button onclick="viewReturnDetails('${
          returnItem.id
        }')" class="text-blue-600 hover:text-blue-900 p-1 rounded" title="View Details">
          <i data-feather="eye" class="w-4 h-4"></i>
        </button>
        <button onclick="processReturnAction('${
          returnItem.id
        }')" class="text-green-600 hover:text-green-900 p-1 rounded ml-2" title="Process">
          <i data-feather="check-circle" class="w-4 h-4"></i>
        </button>
      </td>
    `;

    tbody.appendChild(row);
  });

  feather.replace();
}

// Handle customer search in customer tab
function handleCustomerSearch() {
  const searchInput = document.getElementById("customer-search-input");
  const searchTerm = searchInput ? searchInput.value.toLowerCase() : "";

  const filtered = customerData.filter(
    (customer) =>
      customer.name.toLowerCase().includes(searchTerm) ||
      customer.phone
        .replace(/\s/g, "")
        .toLowerCase()
        .includes(searchTerm.replace(/\s/g, "")) ||
      (customer.email && customer.email.toLowerCase().includes(searchTerm))
  );

  loadCustomerTable(filtered);
}

// Handle return search
function handleReturnSearch() {
  const searchInput = document.getElementById("return-search-input");
  const searchTerm = searchInput ? searchInput.value.toLowerCase() : "";

  const filtered = returnData.filter(
    (returnItem) =>
      returnItem.id.toLowerCase().includes(searchTerm) ||
      returnItem.invoiceNumber.toLowerCase().includes(searchTerm) ||
      returnItem.customer.toLowerCase().includes(searchTerm) ||
      returnItem.product.toLowerCase().includes(searchTerm)
  );

  loadReturnTable(filtered);
}

// Select customer from table - open details modal
function selectCustomerFromTable(customerId) {
  const customer = customerData.find((c) => c.id === customerId);
  if (!customer) return;

  const customerPurchases = customerPurchasesData.filter(
    (p) => p.customerId === customerId
  );
  const customerRepairs = customerRepairsData.filter(
    (r) => r.customerId === customerId
  );
  const totalSpent = customerPurchases.reduce(
    (sum, purchase) => sum + purchase.totalAmount,
    0
  );

  const modalContent = `
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50" onclick="closePOSCustomerDetailsModal(event)">
      <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
          <h3 class="text-lg font-medium text-gray-900">Customer Details</h3>
          <button onclick="closePOSCustomerDetailsModal()" class="text-gray-400 hover:text-gray-600">
            <i data-feather="x" class="w-6 h-6"></i>
          </button>
        </div>
        
        <div class="p-6">
          <!-- Customer Info Header -->
          <div class="bg-gray-50 rounded-lg p-4 mb-6">
            <div class="flex justify-between items-start">
              <div>
                <h4 class="text-xl font-semibold text-gray-900">${
                  customer.name
                }</h4>
                <p class="text-gray-600">${customer.phone}</p>
                <p class="text-gray-600">${
                  customer.email || "No email provided"
                }</p>
              </div>
              <div class="text-right">
                <p class="text-sm text-gray-600 mt-1">Total Spent: <span class="font-semibold">Rs. ${totalSpent.toLocaleString()}</span></p>
              </div>
            </div>
          </div>

          <!-- Tabs -->
          <div class="border-b border-gray-200 mb-6">
            <nav class="-mb-px flex space-x-8">
              <button onclick="switchPOSCustomerTab('purchases')" id="posCustomerPurchasesTab" class="pos-customer-tab-btn border-b-2 border-blue-500 py-2 px-1 text-sm font-medium text-blue-600">
                Purchases
              </button>
              <button onclick="switchPOSCustomerTab('repairs')" id="posCustomerRepairsTab" class="pos-customer-tab-btn border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700">
                Repairs
              </button>
            </nav>
          </div>

          <!-- Tab Content -->
          <div id="posCustomerPurchasesContent" class="pos-customer-tab-content">
            <h5 class="text-lg font-medium text-gray-900 mb-4">Purchase History</h5>
            <div id="posCustomerPurchasesList" class="space-y-4">
              ${
                customerPurchases.length === 0
                  ? `
                <div class="text-center py-8 text-gray-500">
                  No purchase history found
                </div>
              `
                  : customerPurchases
                      .map(
                        (purchase) => `
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex justify-between items-start mb-2">
                    <h6 class="font-medium text-gray-900">Invoice #${
                      purchase.invoiceNo
                    }</h6>
                    <span class="text-sm text-gray-500">${new Date(
                      purchase.purchaseDate
                    ).toLocaleDateString()}</span>
                  </div>
                  
                  <div class="space-y-2 mb-3">
                    ${purchase.items
                      .map(
                        (item) => `
                      <div class="flex justify-between text-sm">
                        <span>${item.productName} x${item.quantity}</span>
                        <span>Rs. ${(
                          item.price * item.quantity
                        ).toLocaleString()}</span>
                      </div>
                    `
                      )
                      .join("")}
                  </div>
                  
                  <div class="flex justify-between items-center pt-2 border-t border-gray-100">
                    <span class="text-sm text-gray-600">Payment: ${
                      purchase.paymentMethod
                    }</span>
                    <span class="font-semibold text-gray-900">Total: Rs. ${purchase.totalAmount.toLocaleString()}</span>
                  </div>
                </div>
              `
                      )
                      .join("")
              }
            </div>
          </div>

          <div id="posCustomerRepairsContent" class="pos-customer-tab-content hidden">
            <h5 class="text-lg font-medium text-gray-900 mb-4">Repair History</h5>
            <div id="posCustomerRepairsList" class="space-y-4">
              ${
                customerRepairs.length === 0
                  ? `
                <div class="text-center py-8 text-gray-500">
                  No repair history found
                </div>
              `
                  : customerRepairs
                      .map((repair) => {
                        const statusColor =
                          repair.status === "Completed"
                            ? "bg-green-100 text-green-800"
                            : repair.status === "In Progress"
                            ? "bg-blue-100 text-blue-800"
                            : repair.status === "Pending"
                            ? "bg-yellow-100 text-yellow-800"
                            : "bg-gray-100 text-gray-800";
                        return `
                  <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex justify-between items-start mb-2">
                      <h6 class="font-medium text-gray-900">Repair #${
                        repair.repairJobNo
                      }</h6>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColor}">
                        ${repair.status}
                      </span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 text-sm mb-3">
                      <div>
                        <span class="text-gray-600">Device:</span>
                        <p class="font-medium">${repair.deviceBrand} - ${
                          repair.deviceModel
                        }</p>
                      </div>
                      <div>
                        <span class="text-gray-600">Issue:</span>
                        <p class="font-medium">${repair.issue}</p>
                      </div>
                    </div>
                    
                    <div class="flex justify-between items-center pt-2 border-t border-gray-100">
                      <span class="text-sm text-gray-600">Date: ${new Date(
                        repair.repairDate
                      ).toLocaleDateString()}</span>
                      <span class="font-semibold text-gray-900">Cost: Rs. ${repair.repairCost.toLocaleString()}</span>
                    </div>
                  </div>
                `;
                      })
                      .join("")
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  `;

  const modalDiv = document.createElement("div");
  modalDiv.id = "pos-customer-details-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  feather.replace();
}

// Close POS customer details modal
function closePOSCustomerDetailsModal(event) {
  if (event && event.target !== event.currentTarget) return;
  const modal = document.getElementById("pos-customer-details-modal");
  if (modal) modal.remove();
}

// Switch tabs in POS customer details modal
function switchPOSCustomerTab(tabName) {
  // Hide all tab contents
  document.querySelectorAll(".pos-customer-tab-content").forEach((content) => {
    content.classList.add("hidden");
  });

  // Remove active class from all tabs
  document.querySelectorAll(".pos-customer-tab-btn").forEach((btn) => {
    btn.classList.remove("border-blue-500", "text-blue-600");
    btn.classList.add("border-transparent", "text-gray-500");
  });

  // Show selected tab content
  document
    .getElementById(
      `posCustomer${tabName.charAt(0).toUpperCase() + tabName.slice(1)}Content`
    )
    .classList.remove("hidden");

  // Add active class to selected tab
  const activeTab = document.getElementById(
    `posCustomer${tabName.charAt(0).toUpperCase() + tabName.slice(1)}Tab`
  );
  activeTab.classList.add("border-blue-500", "text-blue-600");
  activeTab.classList.remove("border-transparent", "text-gray-500");
}

// View customer details
function viewCustomerDetails(customerId) {
  const customer = customerData.find((c) => c.id === customerId);
  if (!customer) return;

  const modalContent = `
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onclick="closeCustomerDetailsModal()">
      <div class="bg-white rounded-lg p-6 max-w-2xl w-full mx-4" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">Customer Details</h2>
          <button onclick="closeCustomerDetailsModal()" class="text-gray-500 hover:text-gray-700">
            <i data-feather="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-600">Customer ID</label>
              <p class="text-gray-900 font-medium">${customer.id}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Name</label>
              <p class="text-gray-900 font-medium">${customer.name}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Phone</label>
              <p class="text-gray-900">${customer.phone}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Email</label>
              <p class="text-gray-900">${customer.email || "-"}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Total Purchases</label>
              <p class="text-gray-900 font-bold text-green-600">Rs. ${
                customer.totalPurchases?.toLocaleString() || "0"
              }</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Purchase Count</label>
              <p class="text-gray-900">${customer.purchaseCount || 0} orders</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Last Purchase</label>
              <p class="text-gray-900">${customer.lastPurchase || "-"}</p>
            </div>
          </div>
          
          <div class="border-t pt-4">
            <h3 class="font-semibold text-gray-800 mb-2">Recent Purchase History</h3>
            <div class="bg-gray-50 p-3 rounded text-sm text-gray-600">
              <p>• Last order: Rs. ${Math.floor(
                Math.random() * 50000 + 5000
              ).toLocaleString()}</p>
              <p>• Average order: Rs. ${Math.floor(
                (customer.totalPurchases || 0) / (customer.purchaseCount || 1)
              ).toLocaleString()}</p>
              <p>• Customer since: ${new Date(
                2023,
                Math.floor(Math.random() * 12),
                1
              ).toLocaleDateString()}</p>
            </div>
          </div>
        </div>
        
        <div class="flex justify-end space-x-3 mt-6">
          <button onclick="closeCustomerDetailsModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
            Close
          </button>
          <button onclick="closeCustomerDetailsModal(); editCustomerDetails(${
            customer.id
          })" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
            Edit Customer
          </button>
        </div>
      </div>
    </div>
  `;

  const modalDiv = document.createElement("div");
  modalDiv.id = "customer-details-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  feather.replace();
}

// Close customer details modal
function closeCustomerDetailsModal() {
  const modal = document.getElementById("customer-details-modal");
  if (modal) modal.remove();
}

// Edit customer details
function editCustomerDetails(customerId) {
  const customer = customerData.find((c) => c.id === customerId);
  if (!customer) return;

  const modalContent = `
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onclick="closeEditCustomerModalBackdrop(event)">
      <div class="bg-white rounded-lg p-6 max-w-2xl w-full mx-4" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">Edit Customer</h2>
          <button onclick="closeEditCustomerModal()" class="text-gray-500 hover:text-gray-700">
            <i data-feather="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <form onsubmit="saveCustomerEdit(event, ${
          customer.id
        })" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
              <input type="text" id="edit-customer-name" value="${
                customer.name
              }" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
              <input type="tel" id="edit-customer-phone" value="${
                customer.phone
              }" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" id="edit-customer-email" value="${
                customer.email || ""
              }"  
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>
          </div>
          
          <div class="flex justify-end space-x-3 pt-4">
            <button type="button" onclick="closeEditCustomerModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  `;

  const modalDiv = document.createElement("div");
  modalDiv.id = "edit-customer-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  feather.replace();
}

// Close edit customer modal
function closeEditCustomerModal() {
  const modal = document.getElementById("edit-customer-modal");
  if (modal) modal.remove();
}

// Close edit customer modal when clicking backdrop
function closeEditCustomerModalBackdrop(event) {
  if (event.target === event.currentTarget) {
    closeEditCustomerModal();
  }
}

// Save customer edit
function saveCustomerEdit(event, customerId) {
  event.preventDefault();

  const customer = customerData.find((c) => c.id === customerId);
  if (!customer) return;

  customer.name = document.getElementById("edit-customer-name").value;
  customer.phone = document.getElementById("edit-customer-phone").value;
  customer.email = document.getElementById("edit-customer-email").value;

  closeEditCustomerModal();
  loadCustomerTable();
  showNotification(`Customer ${customer.name} updated successfully`, "success");
}

// Open add customer from tab
function openAddCustomerFromTab() {
  addNewCustomer();
}

// Open new return form
function openNewReturnForm() {
  const modalContent = `
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" onclick="closeNewReturnModalBackdrop(event)">
      <!-- Modal Size Controls:
           w-[70vw] = 70% of viewport width (change 70 to adjust: 60vw, 80vw, etc.)
           max-w-none = no maximum width limit (or use max-w-7xl for ~80rem)
           min-h-[500px] = minimum height (change to adjust)
      -->
      <div class="bg-white rounded-lg p-8 w-[70vw] max-w-none min-h-[500px] max-h-[85vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">Create New Return</h2>
          <button onclick="closeNewReturnModal()" class="text-gray-500 hover:text-gray-700">
            <i data-feather="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <form onsubmit="saveNewReturn(event)" class="space-y-4">
          <!-- Invoice Search Section -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Invoice Number or Customer *</label>
            <div class="relative">
              <input 
                type="text" 
                id="return-invoice-search" 
                placeholder="Search by invoice number or customer name..."
                onkeyup="searchInvoicesForReturn()"
                onfocus="showInvoiceDropdown()"
                autocomplete="off"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
              />
              <!-- Dropdown Results -->
              <div id="invoice-dropdown" class="absolute z-10 w-full bg-white border border-gray-300 rounded-lg shadow-lg mt-1 max-h-60 overflow-y-auto hidden">
                <!-- Results will be populated here -->
              </div>
            </div>
            <input type="hidden" id="selected-invoice-id" required>
          </div>

          <!-- Selected Invoice Info -->
          <div id="selected-invoice-info" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-medium text-blue-900">Invoice: <span id="display-invoice-number"></span></p>
                <p class="text-sm text-blue-700">Customer: <span id="display-customer-name"></span></p>
                <p class="text-sm text-blue-700">Date: <span id="display-invoice-date"></span></p>
              </div>
              <button type="button" onclick="clearSelectedInvoice()" class="text-blue-600 hover:text-blue-800 text-sm">
                Change
              </button>
            </div>
          </div>

          <!-- Invoice Items Section (shown after invoice selection) -->
          <div id="invoice-items-section" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Items to Return</label>
            <div class="border border-gray-300 rounded-lg divide-y divide-gray-200 max-h-64 overflow-y-auto" id="invoice-items-list">
              <!-- Items will be populated here -->
            </div>
            <div id="return-total-row" class="mt-2 p-3 bg-blue-50 border border-blue-200 rounded-lg flex justify-between items-center">
              <span class="text-sm font-medium text-gray-700">Return Total:</span>
              <span id="return-total-amount" class="text-lg font-bold text-blue-600">Rs. 0</span>
            </div>
          </div>

          <!-- Return Reason and Notes -->
          <div id="return-details-section" class="hidden space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Return Reason *</label>
                <select id="return-reason" required
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                  <option value="">Select Reason</option>
                  <option value="Defective">Defective</option>
                  <option value="Changed Mind">Changed Mind</option>
                  <option value="Wrong Item">Wrong Item</option>
                  <option value="Not as Described">Not as Described</option>
                  <option value="Damaged">Damaged</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Status *</label>
                <select id="return-status" required
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                  <option value="Pending">Pending</option>
                  <option value="Approved">Approved</option>
                  <option value="Completed">Completed</option>
                  <option value="Rejected">Rejected</option>
                </select>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
              <textarea id="return-notes" rows="3"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                placeholder="Additional details about the return..."></textarea>
            </div>
          </div>
          
          <div class="flex justify-end space-x-3 pt-4">
            <button type="button" onclick="closeNewReturnModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
              Cancel
            </button>
            <button type="submit" id="submit-return-btn" disabled class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 disabled:opacity-50 disabled:cursor-not-allowed">
              Create Return
            </button>
          </div>
        </form>
      </div>
    </div>
  `;

  const modalDiv = document.createElement("div");
  modalDiv.id = "new-return-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  feather.replace();
}

// Search invoices for return
function searchInvoicesForReturn() {
  const searchTerm = document
    .getElementById("return-invoice-search")
    .value.toLowerCase();
  const dropdown = document.getElementById("invoice-dropdown");

  if (searchTerm.length === 0) {
    dropdown.classList.add("hidden");
    return;
  }

  const filteredPurchases = customerPurchasesData.filter((purchase) => {
    const customer = customerData.find((c) => c.id === purchase.customerId);
    const customerName = customer ? customer.name.toLowerCase() : "";
    return (
      purchase.invoiceNo.toLowerCase().includes(searchTerm) ||
      customerName.includes(searchTerm)
    );
  });

  if (filteredPurchases.length === 0) {
    dropdown.innerHTML = `
      <div class="px-4 py-3 text-sm text-gray-500 text-center">
        No invoices found
      </div>
    `;
    dropdown.classList.remove("hidden");
    return;
  }

  dropdown.innerHTML = filteredPurchases
    .map((purchase) => {
      const customer = customerData.find((c) => c.id === purchase.customerId);
      return `
      <div class="px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0" onclick="selectInvoiceForReturn(${
        purchase.id
      })">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-sm font-medium text-gray-900">${
              purchase.invoiceNo
            }</p>
            <p class="text-xs text-gray-600">${
              customer ? customer.name : "Unknown Customer"
            }</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-medium text-gray-900">Rs. ${purchase.totalAmount.toLocaleString()}</p>
            <p class="text-xs text-gray-500">${new Date(
              purchase.purchaseDate
            ).toLocaleDateString()}</p>
          </div>
        </div>
      </div>
    `;
    })
    .join("");

  dropdown.classList.remove("hidden");
}

// Show invoice dropdown
function showInvoiceDropdown() {
  searchInvoicesForReturn();
}

// Select invoice for return
function selectInvoiceForReturn(purchaseId) {
  const purchase = customerPurchasesData.find((p) => p.id === purchaseId);
  if (!purchase) return;

  const customer = customerData.find((c) => c.id === purchase.customerId);

  // Hide dropdown
  document.getElementById("invoice-dropdown").classList.add("hidden");

  // Set hidden field
  document.getElementById("selected-invoice-id").value = purchaseId;
  document.getElementById("return-invoice-search").value = purchase.invoiceNo;

  // Show selected invoice info
  document.getElementById("display-invoice-number").textContent =
    purchase.invoiceNo;
  document.getElementById("display-customer-name").textContent = customer
    ? customer.name
    : "Unknown";
  document.getElementById("display-invoice-date").textContent = new Date(
    purchase.purchaseDate
  ).toLocaleDateString();
  document.getElementById("selected-invoice-info").classList.remove("hidden");

  // Load invoice items
  loadInvoiceItems(purchase);

  // Show items section and return details
  document.getElementById("invoice-items-section").classList.remove("hidden");
  document.getElementById("return-details-section").classList.remove("hidden");

  // Enable submit button
  document.getElementById("submit-return-btn").disabled = false;
}

// Load invoice items with checkboxes
function loadInvoiceItems(purchase) {
  const itemsList = document.getElementById("invoice-items-list");

  itemsList.innerHTML = purchase.items
    .map(
      (item, index) => `
    <div class="p-3 hover:bg-gray-50">
      <label class="flex items-center cursor-pointer">
        <input 
          type="checkbox" 
          class="return-item-checkbox w-4 h-4 text-blue-600 rounded focus:ring-blue-500" 
          data-item-index="${index}"
          data-product-name="${item.productName}"
          data-quantity="${item.quantity}"
          data-price="${item.price}"
          onchange="updateReturnTotal()"
        />
        <div class="ml-3 flex-1">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">${
                item.productName
              }</p>
              <p class="text-xs text-gray-500">Quantity: ${
                item.quantity
              } × Rs. ${item.price.toLocaleString()}</p>
            </div>
            <p class="text-sm font-semibold text-gray-900">Rs. ${(
              item.quantity * item.price
            ).toLocaleString()}</p>
          </div>
        </div>
      </label>
    </div>
  `
    )
    .join("");
}

// Clear selected invoice
function clearSelectedInvoice() {
  document.getElementById("selected-invoice-id").value = "";
  document.getElementById("return-invoice-search").value = "";
  document.getElementById("selected-invoice-info").classList.add("hidden");
  document.getElementById("invoice-items-section").classList.add("hidden");
  document.getElementById("return-details-section").classList.add("hidden");
  document.getElementById("invoice-items-list").innerHTML = "";
  document.getElementById("submit-return-btn").disabled = true;
  document.getElementById("return-invoice-search").focus();
}

// Update return total (optional - for display)
function updateReturnTotal() {
  const checkboxes = document.querySelectorAll(".return-item-checkbox:checked");
  let total = 0;
  checkboxes.forEach((cb) => {
    const quantity = parseFloat(cb.dataset.quantity);
    const price = parseFloat(cb.dataset.price);
    total += quantity * price;
  });

  // Update total display
  const totalAmountEl = document.getElementById("return-total-amount");
  if (totalAmountEl) {
    totalAmountEl.textContent = `Rs. ${total.toLocaleString()}`;
  }

  // Enable/disable submit button based on selection
  const submitBtn = document.getElementById("submit-return-btn");
  if (submitBtn) {
    submitBtn.disabled = checkboxes.length === 0;
  }
}

// Close new return modal
function closeNewReturnModal() {
  const modal = document.getElementById("new-return-modal");
  if (modal) modal.remove();
}

// Close new return modal when clicking backdrop
function closeNewReturnModalBackdrop(event) {
  if (event.target === event.currentTarget) {
    closeNewReturnModal();
  }
}

// Save new return
function saveNewReturn(event) {
  event.preventDefault();

  // Get selected invoice
  const purchaseId = parseInt(
    document.getElementById("selected-invoice-id").value
  );
  const purchase = customerPurchasesData.find((p) => p.id === purchaseId);

  if (!purchase) {
    showNotification("Please select a valid invoice", "error");
    return;
  }

  // Get selected items
  const checkboxes = document.querySelectorAll(".return-item-checkbox:checked");

  if (checkboxes.length === 0) {
    showNotification("Please select at least one item to return", "error");
    return;
  }

  const customer = customerData.find((c) => c.id === purchase.customerId);
  const returnedItems = [];
  let totalAmount = 0;

  checkboxes.forEach((cb) => {
    const productName = cb.dataset.productName;
    const quantity = parseInt(cb.dataset.quantity);
    const price = parseFloat(cb.dataset.price);
    const itemTotal = quantity * price;

    returnedItems.push({
      productName,
      quantity,
      price,
      total: itemTotal,
    });

    totalAmount += itemTotal;
  });

  const newReturn = {
    id: `RET-${String(returnData.length + 1).padStart(3, "0")}`,
    invoiceNumber: purchase.invoiceNo,
    customer: customer ? customer.name : "Unknown Customer",
    product:
      returnedItems.length > 1
        ? `${returnedItems.length} items`
        : returnedItems[0].productName,
    returnedItems: returnedItems,
    amount: totalAmount,
    reason: document.getElementById("return-reason").value,
    status: document.getElementById("return-status").value,
    date: new Date().toISOString().split("T")[0],
    notes: document.getElementById("return-notes").value || "",
  };

  returnData.unshift(newReturn);
  closeNewReturnModal();
  loadReturnTable();
  showNotification(
    `Return ${
      newReturn.id
    } created successfully (Rs. ${totalAmount.toLocaleString()})`,
    "success"
  );
}

// View return details
function viewReturnDetails(returnId) {
  const returnItem = returnData.find((r) => r.id === returnId);
  if (!returnItem) return;

  const statusColor =
    returnItem.status === "Completed"
      ? "green"
      : returnItem.status === "Approved"
      ? "blue"
      : returnItem.status === "Pending"
      ? "yellow"
      : "red";

  const modalContent = `
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onclick="closeReturnDetailsModalBackdrop(event)">
      <div class="bg-white rounded-lg p-6 max-w-2xl w-full mx-4" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">Return Details</h2>
          <button onclick="closeReturnDetailsModal()" class="text-gray-500 hover:text-gray-700">
            <i data-feather="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between pb-3 border-b">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">${
                returnItem.id
              }</h3>
              <p class="text-sm text-gray-600">Created on ${returnItem.date}</p>
            </div>
            <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full bg-${statusColor}-100 text-${statusColor}-800">
              ${returnItem.status}
            </span>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-600">Invoice Number</label>
              <p class="text-gray-900 font-medium">${
                returnItem.invoiceNumber
              }</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Customer</label>
              <p class="text-gray-900 font-medium">${returnItem.customer}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Product</label>
              <p class="text-gray-900">${returnItem.product}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Return Amount</label>
              <p class="text-gray-900 font-bold text-red-600">Rs. ${returnItem.amount.toLocaleString()}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-600">Reason</label>
              <p class="text-gray-900">${returnItem.reason}</p>
            </div>
          </div>
          
          ${
            returnItem.notes
              ? `
            <div class="border-t pt-4">
              <label class="block text-sm font-medium text-gray-600 mb-1">Notes</label>
              <div class="bg-gray-50 p-3 rounded text-sm text-gray-700">
                ${returnItem.notes}
              </div>
            </div>
          `
              : ""
          }
          
          ${
            returnItem.status === "Pending" || returnItem.status === "Approved"
              ? `
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <p class="text-sm text-yellow-800">
                <i data-feather="alert-circle" class="w-4 h-4 inline mr-1"></i>
                ${
                  returnItem.status === "Pending"
                    ? "This return is awaiting approval."
                    : "This return has been approved and is ready to be completed."
                }
              </p>
            </div>
          `
              : ""
          }
        </div>
        
        <div class="flex justify-end space-x-3 mt-6">
          <button onclick="closeReturnDetailsModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
            Close
          </button>
          ${
            returnItem.status === "Pending"
              ? `
            <button onclick="closeReturnDetailsModal(); processReturnAction('${returnItem.id}')" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">
              Approve Return
            </button>
          `
              : ""
          }
          ${
            returnItem.status === "Approved"
              ? `
            <button onclick="closeReturnDetailsModal(); processReturnAction('${returnItem.id}')" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
              Complete Return
            </button>
          `
              : ""
          }
        </div>
      </div>
    </div>
  `;

  const modalDiv = document.createElement("div");
  modalDiv.id = "return-details-modal";
  modalDiv.innerHTML = modalContent;
  document.body.appendChild(modalDiv);

  feather.replace();
}

// Close return details modal
function closeReturnDetailsModal() {
  const modal = document.getElementById("return-details-modal");
  if (modal) modal.remove();
}

// Close return details modal when clicking backdrop
function closeReturnDetailsModalBackdrop(event) {
  if (event.target === event.currentTarget) {
    closeReturnDetailsModal();
  }
}

// Process return action
function processReturnAction(returnId) {
  const returnItem = returnData.find((r) => r.id === returnId);
  if (!returnItem) return;

  if (returnItem.status === "Pending") {
    returnItem.status = "Approved";
    loadReturnTable();
    showNotification(`Return ${returnId} approved`, "success");
  } else if (returnItem.status === "Approved") {
    returnItem.status = "Completed";
    loadReturnTable();
    showNotification(`Return ${returnId} completed`, "success");
  }
}

// Handle manual total change
function handleManualTotalChange() {
  const totalEditable = document.getElementById("total-editable");
  const manualTotal = parseFloat(totalEditable.value) || 0;

  // Update the hidden total display
  document.getElementById(
    "total"
  ).textContent = `Rs.${manualTotal.toLocaleString()}`;

  // Recalculate change if cash payment
  if (currentPaymentMethod === "cash") {
    calculateChange();
  }

  showNotification("Total amount manually adjusted", "info");
}

// Add new customer
function addNewCustomer() {
  document.getElementById("add-customer-modal").classList.remove("hidden");
}

// Close add customer modal
function closeAddCustomerModal() {
  document.getElementById("add-customer-modal").classList.add("hidden");
  // Clear form
  document.getElementById("customer-name").value = "";
  document.getElementById("customer-phone").value = "";
  document.getElementById("customer-email").value = "";
  document.getElementById("customer-address").value = "";
}

// Save new customer
function saveNewCustomer(event) {
  event.preventDefault();

  const name = document.getElementById("customer-name").value;
  const phone = document.getElementById("customer-phone").value;
  const email = document.getElementById("customer-email").value;
  const address = document.getElementById("customer-address").value;

  // In a real application, this would save to the backend
  const newCustomer = {
    id: customers.length + 1,
    name,
    phone,
    email,
    address,
  };

  customers.push(newCustomer);

  // Add to customer select
  const customerSelect = document.getElementById("customer-select");
  const option = document.createElement("option");
  option.value = newCustomer.id;
  option.textContent = `${newCustomer.name} - ${newCustomer.phone}`;
  customerSelect.appendChild(option);
  customerSelect.value = newCustomer.id;

  closeAddCustomerModal();
  showNotification("Customer added successfully", "success");
}

// Process payment
function processPayment() {
  // Check if user has permission to process payments
  if (!hasPermission("pos")) {
    showNotification("You do not have permission to process payments", "error");
    return;
  }

  if (cart.length === 0) {
    showNotification("Cart is empty", "error");
    return;
  }

  const total = parseFloat(
    document
      .getElementById("total")
      .textContent.replace("Rs.", "")
      .replace(/,/g, "")
  );

  if (currentPaymentMethod === "cash") {
    const cashReceived =
      parseFloat(document.getElementById("cash-received").value) || 0;
    if (cashReceived < total) {
      showNotification("Insufficient cash received", "error");
      return;
    }
  }

  // Generate invoice number
  const invoiceNumber = `INV${String(++lastInvoiceNumber).padStart(6, "0")}`;

  // Create sale record (in real app, this would be saved to backend)
  const sale = {
    invoiceNumber,
    date: new Date().toISOString(),
    customer: currentCustomer,
    items: [...cart],
    subtotal: cart.reduce(
      (sum, item) =>
        sum + (item.totalPrice || item.total || item.price * item.quantity),
      0
    ),
    discount: 0, // Calculate from form
    total: total,
    paymentMethod: currentPaymentMethod,
    cashReceived:
      currentPaymentMethod === "cash"
        ? parseFloat(document.getElementById("cash-received").value)
        : total,
    change:
      currentPaymentMethod === "cash"
        ? Math.max(
            0,
            parseFloat(document.getElementById("cash-received").value) - total
          )
        : 0,
  };

  // Update product stock (in real app, this would be done on backend)
  cart.forEach((cartItem) => {
    const product = posProducts.find((p) => p.id === cartItem.id);
    if (product) {
      product.stock -= cartItem.quantity;
    }
  });

  // Show success modal
  document.getElementById("invoice-number").textContent = invoiceNumber;
  document.getElementById(
    "payment-total"
  ).textContent = `Rs.${total.toLocaleString()}`;
  document.getElementById("payment-success-modal").classList.remove("hidden");

  // Clear cart and reset form
  cart = [];
  updateCartDisplay();
  document.getElementById("cash-received").value = "";
  document.getElementById("discount-input").value = "";
  document.getElementById("customer-select").value = "";

  showNotification("Payment processed successfully", "success");
}

// Hold sale
function holdSale() {
  if (cart.length === 0) {
    showNotification("Cart is empty", "error");
    return;
  }

  // In a real application, this would save the current cart state
  const heldSale = {
    id: Date.now(),
    date: new Date().toISOString(),
    items: [...cart],
    customer: currentCustomer,
  };

  // Store in localStorage for demo purposes
  const heldSales = JSON.parse(localStorage.getItem("heldSales") || "[]");
  heldSales.push(heldSale);
  localStorage.setItem("heldSales", JSON.stringify(heldSales));

  clearCart();
  showNotification("Sale held successfully", "success");
}

// Print receipt
function printReceipt() {
  if (cart.length === 0) {
    showNotification("No items to print", "error");
    return;
  }

  // Create receipt content
  const receiptWindow = window.open("", "_blank", "width=300,height=600");
  const total = parseFloat(
    document
      .getElementById("total")
      .textContent.replace("Rs.", "")
      .replace(/,/g, "")
  );

  receiptWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Receipt</title>
            <style>
                body { font-family: 'Courier New', monospace; font-size: 12px; margin: 10px; }
                .header { text-align: center; border-bottom: 1px dashed #000; padding-bottom: 10px; margin-bottom: 10px; }
                .item { display: flex; justify-content: space-between; margin-bottom: 5px; }
                .total { border-top: 1px dashed #000; padding-top: 10px; margin-top: 10px; font-weight: bold; }
                .center { text-align: center; }
            </style>
        </head>
        <body>
            <div class="header">
                <h2>Thilina Mobiles</h2>
                <p>Mobile Shop & Accessories</p>
                <p>Receipt</p>
                <p>Date: ${new Date().toLocaleString()}</p>
                <p>Invoice: INV${String(lastInvoiceNumber).padStart(6, "0")}</p>
            </div>
            
            <div class="items">
                ${cart
                  .map(
                    (item) => `
                    <div class="item">
                        <span>${item.name}</span>
                    </div>
                    <div class="item">
                        <span>${
                          item.quantity
                        } x Rs.${item.price.toLocaleString()}</span>
                        <span>Rs.${item.total.toLocaleString()}</span>
                    </div>
                `
                  )
                  .join("")}
            </div>
            
            <div class="total">
                <div class="item">
                    <span>TOTAL:</span>
                    <span>Rs.${total.toLocaleString()}</span>
                </div>
                ${
                  currentPaymentMethod === "cash"
                    ? `
                    <div class="item">
                        <span>Cash Received:</span>
                        <span>Rs.${parseFloat(
                          document.getElementById("cash-received").value || 0
                        ).toLocaleString()}</span>
                    </div>
                    <div class="item">
                        <span>Change:</span>
                        <span>Rs.${Math.max(
                          0,
                          parseFloat(
                            document.getElementById("cash-received").value || 0
                          ) - total
                        ).toLocaleString()}</span>
                    </div>
                `
                    : ""
                }
            </div>
            
            <div class="center" style="margin-top: 20px;">
                <p>Thank you for your business!</p>
                <p>Visit us again</p>
            </div>
        </body>
        </html>
    `);

  receiptWindow.document.close();
  receiptWindow.print();
}

// New sale
function newSale() {
  document.getElementById("payment-success-modal").classList.add("hidden");
  clearCart();

  // Reload products to reflect updated stock
  loadProducts();
}

// Show keyboard shortcuts
function showKeyboardShortcuts() {
  document.getElementById("shortcuts-modal").classList.remove("hidden");
}

// Close shortcuts modal
function closeShortcutsModal() {
  document.getElementById("shortcuts-modal").classList.add("hidden");
}

// Show notification
function showNotification(message, type = "info") {
  // Create notification element
  const notification = document.createElement("div");
  notification.className = `pos-notification fixed top-4 right-4 z-50 px-4 py-2 rounded-lg text-white text-sm font-medium shadow-lg`;

  // Set color based on type
  switch (type) {
    case "success":
      notification.classList.add("bg-green-500");
      break;
    case "error":
      notification.classList.add("bg-red-500");
      break;
    case "warning":
      notification.classList.add("bg-yellow-500");
      break;
    default:
      notification.classList.add("bg-blue-500");
  }

  notification.textContent = message;

  // Add to DOM
  document.body.appendChild(notification);

  // Remove after 3 seconds
  setTimeout(() => {
    notification.style.animation = "slideInRight 0.3s ease-out reverse";
    setTimeout(() => {
      if (notification.parentNode) {
        notification.parentNode.removeChild(notification);
      }
    }, 300);
  }, 3000);
}

// Logout function
function logout() {
  if (confirm("Are you sure you want to logout?")) {
    // Clear session storage
    sessionStorage.removeItem("authToken");
    sessionStorage.removeItem("user");

    // Show notification and redirect
    showNotification("Logged out successfully", "info");
    setTimeout(() => {
      window.location.href = "login.html";
    }, 1000);
  }
}

// Navigate to dashboard (with role checking)
function goToDashboard() {
  const userInfo = sessionStorage.getItem("user");

  try {
    const user = JSON.parse(userInfo);
    const role = user.role ? user.role.toLowerCase() : "";

    // Cashiers stay on POS, but we can allow them to access dashboard if needed
    if (role === "cashier") {
      if (
        confirm(
          "You are logged in as a cashier. Are you sure you want to go to the main dashboard?"
        )
      ) {
        window.location.href = "Dashboard.html";
      }
    } else {
      window.location.href = "Dashboard.html";
    }
  } catch (e) {
    // If we can't parse user info, just go to dashboard
    window.location.href = "Dashboard.html";
  }
}

// Check if user has permission for certain actions
function hasPermission(action) {
  const userInfo = sessionStorage.getItem("user");

  try {
    const user = JSON.parse(userInfo);
    const role = user.role ? user.role.toLowerCase() : "";

    // Define permissions based on role
    const permissions = {
      admin: ["all"],
      administrator: ["all"],
      manager: ["pos", "reports", "customers", "inventory_view"],
      cashier: ["pos", "customers_add"],
      accountant: ["reports", "pos_view"],
    };

    const userPermissions = permissions[role] || [];
    return userPermissions.includes("all") || userPermissions.includes(action);
  } catch (e) {
    // If we can't determine permissions, allow basic POS operations
    return ["pos", "customers_add"].includes(action);
  }
}

