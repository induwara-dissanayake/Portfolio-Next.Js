      items: [],
    },
    {
      id: "RP-2024-004",
      device: "Huawei P30",
      imei: "789012345678901",
      customer: "Ruwan Jayasekara",
      customerId: null,
      phone: "+94 76 234 5678",
      email: null,
      issue: "Charging Port Repair",
      status: "pending_parts",
      estimatedCost: 8000,
      actualCost: 0,
      receivedDate: "2024-11-12",
      completedDate: null,
      technician: "Kasun Silva",
      notes: "Waiting for charging port component delivery",
